NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
NEXT_PUBLIC_SUPABASE_SCHEMA=

# Resend API Key - get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Send Email Hook Secret - generate from Supabase Dashboard > Authentication > Hooks
# Paste the full dashboard value. The Edge Function accepts both full
# "v1,whsec_" values and raw secrets for local compatibility.
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Auth email sender metadata
AUTH_EMAIL_APP_URL=http://localhost:3000
AUTH_EMAIL_PRODUCT_NAME="Your App"
AUTH_EMAIL_FROM="Your App <noreply@joe-taylor.me>"
AUTH_EMAIL_REPLY_TO=support@joe-taylor.me
AUTH_EMAIL_EXPIRY_COPY="This code expires soon. Request a new email if it no longer works."

# API Keys for the different AI providers
ANTHROPIC_API_KEY=sk-...
OPENAI_API_KEY=sk-...
CEREBRAS_API_KEY=csk-...
XAI_API_KEY=xai-...

# Shared chat web search / scrape providers (server-side only)
# Prefer Firecrawl when both are set unless WEB_SEARCH_PROVIDER overrides.
FIRECRAWL_API_KEY=fc-...
# Get your Jina AI API key for free: https://jina.ai/?sui=apikey
JINA_API_KEY=jina_...
# Optional: force provider when multiple keys are configured (`firecrawl` | `jina`)
WEB_SEARCH_PROVIDER=

# Claude-only fallback limit used when no shared web search provider is configured
WEB_SEARCH_MAX_USES=5
